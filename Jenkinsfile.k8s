pipeline {
    agent any

    options {
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        APP_URL = 'http://192.168.1.49:31805'
    }

    stages {
        stage('Check tools') {
            steps {
                sh '/usr/local/bin/kubectl version --client'
            }
        }



        stage('Build application image') {
            steps {
                sh '''
                    set -eu
                    docker build \
                        -f Dockerfile.app \
                        -t devops-web:${BUILD_NUMBER} \
                        .
                '''
            }
        }

        stage('Test application image') {
            steps {
                sh '''
                    set -eu

                    docker image inspect \
                        devops-web:${BUILD_NUMBER} > /dev/null

                    docker run --rm --entrypoint cat \
                        devops-web:${BUILD_NUMBER} \
                        /usr/share/nginx/html/index.html \
                        > image-index.html

                    grep -Fq \
                        'Deployed by Jenkins to Kubernetes' \
                        image-index.html
                '''
                echo 'Imaginea proprie contine pagina HTML asteptata.'
            }
        }



         stage('Publish image to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        export DOCKER_CONFIG="$(mktemp -d)"
                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                        printf '%s' "$DOCKERHUB_TOKEN" |
                            docker login \
                                --username "$DOCKERHUB_USER" \
                                --password-stdin

                        docker tag \
                            "devops-web:${BUILD_NUMBER}" \
                            "mihaistanciu1984/devops-web:${BUILD_NUMBER}"

                        docker push \
                            "mihaistanciu1984/devops-web:${BUILD_NUMBER}"

                        docker logout
                    '''
                }
            }
        }



        stage('Generate deployment manifests') {
            steps {
                sh 'mkdir -p build/deploy'

                writeFile(
                    file: 'build/deploy/kustomization.yaml',
                    text: """
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../../k8s

images:
  - name: mihaistanciu1984/devops-web
    newTag: "${env.BUILD_NUMBER}"
"""
                )

                sh '''
                    set -eu
                    /usr/local/bin/kubectl kustomize build/deploy/ \
                        > build/rendered-manifests.yaml
                '''

                archiveArtifacts(
                    artifacts: 'build/rendered-manifests.yaml',
                    fingerprint: true
                )
            }
        }

          stage('Validate manifests') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k3s-devops-lab',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set +x
                        /usr/local/bin/kubectl apply \
                            --dry-run=server \
                            --request-timeout=30s \
                            --f build/rendered-manifests.yaml
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k3s-devops-lab',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set +x
                        set -e
                        /usr/local/bin/kubectl apply \
                            --request-timeout=30s \
                            --f build/rendered-manifests.yaml

                        /usr/local/bin/kubectl rollout status \
                            deployment/nginx-lab \
                            --namespace=devops-lab \
                            --timeout=180s
                    '''
                }
            }
        }

        stage('HTTP smoke test') {
            steps {
                sh '''
                    set -eu
                    curl --fail --silent --show-error \
                        --connect-timeout 5 \
                        --max-time 15 \
                        "$APP_URL" \
                        -o nginx-response.html

                    grep -Fq 'Deployed by Jenkins to Kubernetes' nginx-response.html
                '''
                echo 'Deployment verificat prin HTTP.'
            }
        }
    }
}
